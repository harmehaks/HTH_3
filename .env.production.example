# Copy to .env.production ON YOUR SERVER, then enter real credentials privately.
# Blank required values intentionally prevent Compose from starting.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
DEMO_MODE=false
AUTH0_BASE_URL=https://mr-redactor.vip
AUTH0_ISSUER_BASE_URL=https://dev-i7p4kdozefycl6u7.ca.auth0.com
AUTH0_CLIENT_ID=EdEu2b1ioiUTJrEvBVTDxuB1XSuOLzOX
AUTH0_CLIENT_SECRET=
AUTH0_ROLES_CLAIM=https://redactor.app/roles
SESSION_SECRET=

# Full Tiger connection URL, with URL-encoded password and actual host/port/database.
# Omit sslmode/sslcert/sslkey/sslrootcert URL parameters: the app verifies TLS itself.
DATABASE_URL=
DATABASE_SSL=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional voice integration.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

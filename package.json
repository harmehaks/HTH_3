{
  "name": "redactor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "start:local": "node scripts/start-local.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "evaluate": "node scripts/evaluate-evidence.js",
    "evaluate:smoke": "node scripts/evaluate.js",
    "evaluate:gemini": "node scripts/evaluate-evidence.js --engine=gemini",
    "format": "prettier --write src server tests scripts public docs *.js *.json *.md *.yaml",
    "typecheck": "tsc --noEmit",
    "verify:production": "node scripts/verify-production.js",
    "verify:container": "node scripts/verify-container.js",
    "evaluate:spans": "node scripts/benchmark-spans.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-openid-connect": "^2.19.2",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}

# Local demo runs with no credentials. Never commit .env.
PORT=3001
HOST=127.0.0.1
DEMO_MODE=true
SESSION_SECRET=replace-with-at-least-32-random-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional Tiger Data / PostgreSQL URL; otherwise existing local SQLite is used.
DATABASE_URL=
DATABASE_SSL=true
# Optional migration destination. Does not switch app storage until DATABASE_URL changes.
MIGRATION_DATABASE_URL=
# Auth0 Regular Web Application. Disable demo mode when configured.
# npm run dev:auth0 selects the supplied localhost:3000 Express application.
# Use that application's matching client secret; see docs/AUTH0_SETUP.md.
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_BASE_URL=http://localhost:5173
# Keep the same namespace in your Auth0 Action and application configuration.
AUTH0_ROLES_CLAIM=https://redactor.app/roles
